# ローカルで試すとき用。GitHub Actions では Secrets に同じ名前で登録します。
# 使い方: cp .env.example .env して値を入れ、 set -a; source .env; set +a

# --- AI（未設定でもテンプレート出力で動きます） ---
ANTHROPIC_API_KEY=

# --- カレンダー ---
# Googleカレンダー → 設定と共有 → 「カレンダーの非公開URL(iCal形式)」
CALENDAR_ICS_URL=

# --- Threads（投稿の書き出しに使う。使わないなら空のままでOK） ---
# Meta for Developers でアプリを作って発行する長期トークン。
# 他人のアカウントを取るには threads_profile_discovery の審査が要ります。
# 手順: docs/threads-export.md
THREADS_ACCESS_TOKEN=

# --- 通知（使うものだけ） ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL=
